#
# Build ignores
#
#.*
*.o
*.o.*
*.obj
*.exe
*.a
*.so
*.so.*
*.1.gz

#
# Never ignore these
#
!.gitignore

#
# Normal output and testing dirs
#
/build_date.h
/rescuecopy
/rescuecopy*.exe
/rescuecopy-*-*/
/rescuecopy-*-*.zip
/*.pkg.tar.*
/ljc_vercheck*
test_temp
output.log

#
# Backups / patches
#
*~
*.orig
*.rej
/*.patch

#
# debugging and editor stuff
#
core
.gdb_history
.gdbinit
.*.swp
*.gcda
*.gcno
*.gcov
cachegrind.out.*

# Mac OS
.DS_Store
